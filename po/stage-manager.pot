#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:9
msgid ""
"When a window is maximized, automatically move it to a new workspace. When "
"unmaximized, return it to the previous workspace."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:14
msgid "Enable Stage Manager Sidebar"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:15
msgid ""
"Show a sidebar with inactive window thumbnails on the left side of the "
"screen."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:22
msgid "Width of the stage manager sidebar in pixels."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:29
msgid "Duration of sidebar show/hide animations in milliseconds."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:35
msgid ""
"When off (default): the sidebar stays visible, drawn over your windows; the "
"empty space around the cards passes clicks through to whatever is "
"underneath. When on: the sidebar stays off screen and is revealed by moving "
"the pointer to the left edge."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:40
msgid "Reserve Space for the Sidebar"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:41
msgid ""
"Shrink the work area so maximized windows stop underneath the sidebar "
"instead of being covered by it, the way macOS shifts the stage across. Only "
"applies when auto-hide is off, because a reserved strut cannot animate."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:47
msgid "Auto-hide Delay"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:48
msgid ""
"Delay in milliseconds before hiding the sidebar after the pointer leaves."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.stage-manager.gschema.xml:55
msgid ""
